# .env.example
# ============================================
# SPURI API - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================

# ─────────────────────────────────────────────────────────────────────────────
# Parte 3 do Plano de Atualizações: as variáveis abaixo também podem ser gravadas
# no banco pela tela de administração (fpp), sem novo deploy. A ordem de leitura
# é banco → variável de ambiente, então manter tudo aqui continua funcionando:
#   ALLOWED_ORIGINS, JWT_EXPIRY_HOURS, LOG_LEVEL, EMAIL_FROM, BREVO_API_KEY,
#   ZIETT_API_KEY, APPYPAY_RESOURCE, RECONCILIACAO_*, MEGA_EMAIL, MEGA_PASSWORD,
#   MEGA_ROOT_FOLDER
# O resto (DATABASE_URL, JWT_SECRET, ENV, PORT, STORAGE_PROVIDER, ...) é só
# ambiente: o servidor precisa deles para chegar ao banco ou para proteger o cofre.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# Servidor / Ambiente
# =============================================================================
PORT=8080
ENV=development # development, test ou production

# Lista separada por vírgula de origens permitidas (CORS).
ALLOWED_ORIGINS=http://localhost:3000,https://seu-frontend.vercel.app

# =============================================================================
# Banco de Dados
# =============================================================================
# Use DATABASE_URL para provedores gerenciados (Neon, Supabase, Aiven, etc.).
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Alternativa ao DATABASE_URL: variáveis individuais de conexão.
# Usadas apenas quando DATABASE_URL não estiver definido.
DB_HOST=localhost
DB_PORT=5432
DB_USER=fredy
DB_PASSWORD=fredy123
DB_NAME=spuri_db
DB_SSLMODE=disable

# Pool PostgreSQL (o backend normaliza valores acima destes limites seguros por instância).
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_TIME_SECONDS=120
DB_HEALTH_TIMEOUT_SECONDS=3

# Opções para provedores/poolers como Neon/PgBouncer.
DB_ALLOW_POOLER=false
DB_FORCE_SINGLE_CONN=false

# Teste opcional de integridade de banco; deixe 0 fora de execuções dedicadas.
SPURI_RUN_DB_INTEGRITY_TESTS=0

# =============================================================================
# Segurança / JWT
# =============================================================================
# JWT_SECRET agora tem DOIS usos: (1) assinar/validar tokens JWT de sessão
# (como sempre) e (2) servir de raiz para derivar as chaves AES-256 que
# cifram segredos financeiros (AppyPay) e tokens de comunicação
# (GoSMS/Ziett) — ver spuri/internal/security.DeriveKey. A configuração
# desta variável não muda: continua sem exigência de tamanho mínimo, com o
# mesmo comportamento de sempre.
JWT_SECRET=seu_segredo_muito_forte_aqui
JWT_EXPIRY_HOURS=24

# A API AppyPay é selecionada automaticamente: ENV=development/test usa TEST;
# ENV=production usa PROD. Não configure client_id/client_secret/webhook aqui:
# eles são armazenados cifrados por academia/Spuri pelo endpoint financeiro
# (POST/PUT /financeiro/appypay/credenciais).
#
# APPYPAY_RESOURCE é a exceção: é o "resource" (UUID) exigido pela AppyPay no
# pedido de token OAuth2, e identifica a API da AppyPay em si (não o
# merchant) — por isso é o mesmo valor para todas as academias/Spuri no mesmo
# ambiente, e fica aqui em vez de no endpoint financeiro. Obrigatória para
# qualquer operação AppyPay (cobrança, QR Code, consulta ou geração de token);
# o servidor recusa iniciar sem ela definida.
APPYPAY_RESOURCE=substitua-pelo-resource-fornecido-pela-appypay

# -----------------------------------------------------------------------------
# Reconciliação automática de cobranças pendentes (todas OPCIONAIS)
# -----------------------------------------------------------------------------
# Job em segundo plano que, como rede de segurança dos webhooks, pergunta ao
# provedor como estão as cobranças ainda pendentes e aplica o resultado pelo
# mesmo caminho do webhook. Não faz polling no banco (importante com NeonDB, que
# cobra por tempo de computação): as pendentes ficam em memória, carregadas por
# UMA consulta no arranque e recarregadas uma vez por dia. Uma verificação que
# conclui "continua pendente" não toca o banco; só uma mudança de estado toca.
#
# Ligado por padrão. Com MAIS DE UMA instância do servidor, deixe ligado em uma
# só (as demais com RECONCILIACAO_ATIVA=false): é idempotente, mas as outras só
# duplicariam as consultas ao provedor.
#RECONCILIACAO_ATIVA=true
# Consultas simultâneas por provedor.
#RECONCILIACAO_CONCORRENCIA=3
# Taxa máxima de consultas por provedor.
#RECONCILIACAO_CHAMADAS_POR_SEGUNDO=2
# Por quanto tempo as credenciais decifradas ficam em memória (evita reler o
# cofre a cada consulta). Padrão: 6 h.
#RECONCILIACAO_CACHE_CREDENCIAIS_SEG=21600
# Recarga das pendentes do banco, em minutos. Padrão: 1440 (diária); 0 = só no
# arranque.
#RECONCILIACAO_RESYNC_MIN=1440

# URL Frontend (para links nos emails).
FRONTEND_URL=https://seu-frontend.vercel.app

# =============================================================================
# E-mail — Brevo é o ÚNICO canal (API HTTP, porta 443)
# =============================================================================
# Tarefa 123: EmailJS e SMTP foram eliminados. Tudo o que envia e-mail (aviso de
# nova academia, verificação de e-mail, recuperação de senha por link, boas-vindas
# de administrador e código do 2FA) passa pelo Brevo. Sem Brevo configurado o
# envio falha de forma explícita (503/erro) — nada é "fingido" nem escrito no log.
# 1. Crie uma conta em https://www.brevo.com (plano free: 300 e-mails/dia no
#    momento em que isto foi escrito — conferir limite atual).
# 2. Verifique UM remetente em https://app.brevo.com/settings/senders e use-o em
#    EMAIL_FROM (não existe mais fallback para EMAIL_USER).
# 3. Gere uma API key em https://app.brevo.com/settings/keys/api e cole abaixo.
EMAIL_FROM=
BREVO_API_KEY=

# Verificação em duas etapas (2FA) por e-mail (tarefa 122): o código de 6 dígitos
# é enviado pelo Brevo, configurado acima. Diferente dos avisos acima, aqui um
# envio que falha é erro de verdade (o login/ativação não conclui) — sem Brevo o
# 2FA não funciona. Somente em DESENVOLVIMENTO, com o Brevo vazio, defina true
# para registrar o código no log do servidor. É ignorado com ENV=production.
# DOIS_FATORES_LOG_CODIGO=false

# Credenciais temporárias (Tarefa 123): senhas geradas para contas criadas por
# terceiros seguem por SMS (estudante/academia) ou por e-mail (administrador) e
# SÓ em ENV=production. Somente em DESENVOLVIMENTO, defina true para escrever
# usuário e senha temporária no log do servidor (testes locais). É ignorado
# com ENV=production.
# CREDENCIAIS_LOG_DEV=false

# =============================================================================
# Armazenamento de Arquivos (Mega)
# =============================================================================
# IMPORTANTE: o storage de arquivos é sempre o Mega remoto real, com
# MEGA_EMAIL/MEGA_PASSWORD obrigatórios, EXCETO se STORAGE_PROVIDER=local
# for definido explicitamente (uso local/testes, ver abaixo). Nenhum outro
# valor de nenhuma outra variável (incluindo ENV) jamais ativa storage
# local — não deixe STORAGE_PROVIDER=local configurado em produção.
STORAGE_PROVIDER=mega
MEGA_EMAIL=conta@exemplo.com
MEGA_PASSWORD=senha-mega
MEGA_ROOT_FOLDER=spuri

# Desenvolvimento/testes locais sem Mega real:
# STORAGE_PROVIDER=local
MEGA_LOCAL_ROOT=data/mega_storage

# =============================================================================
# Variáveis legadas/documentais não lidas diretamente pelo backend atual
# =============================================================================
# URL Base Backend (para logs internos/documentação operacional).
BASE_URL=https://seu-backend.seu-dominio.com

# Monitoramento/logs documentados para operação.
LOG_LEVEL=info
LOG_FORMAT=json

# Feature flags documentadas.
ENABLE_WEB_SEARCH=false

# =============================================================================
# Ziett (CPaaS de SMS) — rota isolada de teste de integração
# =============================================================================
# Usada exclusivamente por POST /integracoes/ziett/mensagens/teste.
# zk_test_: ambiente de teste, sem custo e sem envio real.
# zk_live_: produção, envia SMS real e pode gerar custo.
ZIETT_API_KEY=zk_test_substitua_pela_sua_chave

# =============================================================================
# Comunicação (módulo real — GoSMS/Ziett)
# =============================================================================
# Os tokens de API de GoSMS/Ziett (gravados em
# projection_remetentes_comunicacao, cadastrados via POST
# /comunicacao/remetentes) são cifrados com uma chave derivada de
# JWT_SECRET (ver acima) — não precisa configurar nada aqui além de
# JWT_SECRET. Este módulo nunca lê ZIETT_API_KEY nem qualquer outra
# variável de ambiente para enviar mensagens reais; o token de cada
# provedor vem sempre do banco, cifrado.

# =============================================================================
# Bootstrap do primeiro administrador FPP (POST /bootstrap) — SEC-11
# =============================================================================
# Sem BOOTSTRAP_TOKEN a rota fica desativada (403). O cliente envia o valor no
# header X-Bootstrap-Token (o nome antigo BOOTSTRAP_TOKEN também é aceito, mas
# vários proxies descartam headers com sublinhado). Gere com: openssl rand -hex 32
# Remova a variável do ambiente depois de criar o primeiro admin.
BOOTSTRAP_TOKEN=
# Só fora de produção (ENV != production):
# BOOTSTRAP_TOKEN_DEV=
