+	if err := f.client.DB().QueryRow(`SELECT COUNT(*) FROM spuri_ledger WHERE aggregate_id=$1 AND event_type=$2`, f.chargeID, evento).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
